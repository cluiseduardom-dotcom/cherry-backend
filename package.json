{
  "name": "cherry-backend",
  "version": "2.4.0",
  "description": "Cherry ERP Backend",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/database/migrate.js && node src/server.js",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:coverage": "jest --selectProjects unit --coverage",
    "db:migrate": "node src/database/migrate.js",
    "tenant:provisionar": "node scripts/provisionar-tenant.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
