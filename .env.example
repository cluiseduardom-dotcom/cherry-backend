# Host remoto sempre usa TLS com certificado verificado (src/config/securePgPool.js), qualquer que seja o sslmode.
DATABASE_URL=postgresql://user:password@host:port/database
JWT_SECRET=your-secret-key
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
# Opcional: papel dono do schema, usado SÓ pelo executor de migrations. Ausente = usa DATABASE_URL.
DATABASE_MIGRATION_URL=
# Testes de INTEGRAÇÃO (npm run test:integration): NÃO coloque aqui. Defina TEST_DATABASE_URL no
# ambiente do shell, apontando para um banco de testes ISOLADO (ex.: cherry_test num Postgres
# local). O .env e o DATABASE_URL acima nunca são usados pelos testes. Veja docs/TESTES.md.
# TEST_DATABASE_URL=postgresql://usuario:senha@localhost:5432/cherry_test

# --- Mercado Pago (Pix com comissão da plataforma). Sem estas variáveis a integração fica desligada. ---
# Valores reais só no ambiente (Render); nunca no repositório. Detalhes em docs/MERCADOPAGO_PIX.md
MP_APP_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MP_TOKEN_ENC_KEY=
MP_FRONTEND_URL=
# Opcional: e-mail neutro da plataforma usado como pagador do Pix (sem ele, usa o e-mail de contato da empresa)
MP_EMAIL_PAGADOR_PADRAO=
# true = usa credenciais de teste no OAuth
MP_SANDBOX=
